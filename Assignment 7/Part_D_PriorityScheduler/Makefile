# xv6 Makefile snippet for Question 4: Priority Scheduling
# Add _priotest to UPROGS in Makefile:

# UPROGS=\
#   _cat\
#   _echo\
#   _forktest\
#   _grep\
#   _init\
#   _kill\
#   _ln\
#   _ls\
#   _mkdir\
#   _rm\
#   _sh\
#   _stressfs\
#   _usertests\
#   _wc\
#   _zombie\
#   _priotest\

# EXTRA=\
#   priotest.c\

# To build and run:
# 1. Copy proc.c, proc.h, trap.c, sysproc.c, syscall.c, syscall.h, defs.h, user.h, usys.S to xv6 directory
# 2. Add priotest.c to xv6 directory
# 3. make clean && make qemu-nox
# 4. In xv6 shell:
#    $ priotest
