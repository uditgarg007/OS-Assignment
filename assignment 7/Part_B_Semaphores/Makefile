# xv6 Makefile snippet for Question 2: Semaphore Support
# 1. Add semaphore.o to OBJS:
# OBJS = \
#   bio.o\
#   cprintf.o\
#   fs.o\
#   ide.o\
#   ioapic.o\
#   kalloc.o\
#   kbd.o\
#   lapic.o\
#   log.o\
#   main.o\
#   mp.o\
#   picirq.o\
#   pipe.o\
#   proc.o\
#   semaphore.o\
#   ...

# 2. Add _synctest and _prodcons to UPROGS:
# UPROGS=\
#   _cat\
#   _echo\
#   _forktest\
#   _grep\
#   _init\
#   _kill\
#   _ln\
#   _ls\
#   _mkdir\
#   _rm\
#   _sh\
#   _stressfs\
#   _usertests\
#   _wc\
#   _zombie\
#   _synctest\
#   _prodcons\

# EXTRA=\
#   synctest.c\
#   prodcons.c\

# To build and run:
# 1. Copy all kernel files into xv6 directory
# 2. Run: make clean && make qemu-nox
# 3. Inside xv6:
#    $ synctest
#    $ prodcons
