# xv6 Makefile snippet for Question 1: Thread Support
# To include threadtest in xv6 build, add _threadtest to UPROGS:

# In Makefile:
# UPROGS=\
#   _cat\
#   _echo\
#   _forktest\
#   _grep\
#   _init\
#   _kill\
#   _ln\
#   _ls\
#   _mkdir\
#   _rm\
#   _sh\
#   _stressfs\
#   _usertests\
#   _wc\
#   _zombie\
#   _threadtest\

# EXTRA=\
#   threadtest.c\

# To build and run xv6 with Question 1 modifications:
# 1. Copy proc.c, proc.h, sysproc.c, syscall.c, syscall.h, defs.h, user.h, usys.S to xv6 directory
# 2. Add threadtest.c to xv6 directory
# 3. make clean
# 4. make qemu-nox
# 5. Inside xv6 shell: run `threadtest`
